# Copia este fichero como .env.local y rellena los valores de tu proyecto Supabase
# (Project Settings → API). .env.local NO se sube a GitHub.
#
# Solo van aquí claves pensadas para el cliente (prefijo EXPO_PUBLIC_).
# La clave secreta de Supabase y la de Gemini NUNCA van en este fichero:
# se guardan como secretos de las Edge Functions en el panel de Supabase.

EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
